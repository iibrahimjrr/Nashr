{"ast":null,"code":"// src/hooks/useSearch.js\nimport{useState,useMemo}from\"react\";export function useSearch(books){const[query,setQuery]=useState(\"\");const[category,setCategory]=useState(\"All\");const filtered=useMemo(()=>{return books.filter(b=>{const matchCat=category===\"All\"||b.category===category;const q=query.toLowerCase();const matchQuery=!q||b.title.toLowerCase().includes(q)||b.author.toLowerCase().includes(q);return matchCat&&matchQuery;});},[books,query,category]);return{query,setQuery,category,setCategory,filtered};}","map":{"version":3,"names":["useState","useMemo","useSearch","books","query","setQuery","category","setCategory","filtered","filter","b","matchCat","q","toLowerCase","matchQuery","title","includes","author"],"sources":["D:/EgyBooks/frontend/src/hooks/useSearch.js"],"sourcesContent":["// src/hooks/useSearch.js\nimport { useState, useMemo } from \"react\";\n\nexport function useSearch(books) {\n  const [query, setQuery] = useState(\"\");\n  const [category, setCategory] = useState(\"All\");\n\n  const filtered = useMemo(() => {\n    return books.filter((b) => {\n      const matchCat = category === \"All\" || b.category === category;\n      const q = query.toLowerCase();\n      const matchQuery =\n        !q ||\n        b.title.toLowerCase().includes(q) ||\n        b.author.toLowerCase().includes(q);\n      return matchCat && matchQuery;\n    });\n  }, [books, query, category]);\n\n  return { query, setQuery, category, setCategory, filtered };\n}\n"],"mappings":"AAAA;AACA,OAASA,QAAQ,CAAEC,OAAO,KAAQ,OAAO,CAEzC,MAAO,SAAS,CAAAC,SAASA,CAACC,KAAK,CAAE,CAC/B,KAAM,CAACC,KAAK,CAAEC,QAAQ,CAAC,CAAGL,QAAQ,CAAC,EAAE,CAAC,CACtC,KAAM,CAACM,QAAQ,CAAEC,WAAW,CAAC,CAAGP,QAAQ,CAAC,KAAK,CAAC,CAE/C,KAAM,CAAAQ,QAAQ,CAAGP,OAAO,CAAC,IAAM,CAC7B,MAAO,CAAAE,KAAK,CAACM,MAAM,CAAEC,CAAC,EAAK,CACzB,KAAM,CAAAC,QAAQ,CAAGL,QAAQ,GAAK,KAAK,EAAII,CAAC,CAACJ,QAAQ,GAAKA,QAAQ,CAC9D,KAAM,CAAAM,CAAC,CAAGR,KAAK,CAACS,WAAW,CAAC,CAAC,CAC7B,KAAM,CAAAC,UAAU,CACd,CAACF,CAAC,EACFF,CAAC